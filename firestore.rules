rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function accessPath() {
      return /databases/$(database)/documents/access/$(request.auth.uid);
    }

    function isStaff() {
      return signedIn()
        && !isAnonymous()
        && exists(accessPath())
        && get(accessPath()).data.active == true;
    }

    function role() {
      return get(accessPath()).data.role;
    }

    function isAdmin() {
      return isStaff() && role() == "ADMIN";
    }

    function isWaiter() {
      return isStaff() && role() == "WAITER";
    }

    function isKitchen() {
      return isStaff() && role() == "KITCHEN";
    }

    // Mirrors the client's hasPermission("manage_menu") check: an admin
    // always qualifies, or any staff account the admin explicitly granted
    // menu-management rights to via Personal → Permisos. Without this, the
    // permission toggle in the UI does nothing — the write still gets
    // rejected here, silently, no matter what the app shows on screen.
    function hasMenuPermission() {
      return isStaff() && (
        role() == "ADMIN" ||
        (
          get(accessPath()).data.permissions is list &&
          (
            "manage_menu" in get(accessPath()).data.permissions ||
            "products" in get(accessPath()).data.permissions ||
            "menu" in get(accessPath()).data.permissions ||
            "carta" in get(accessPath()).data.permissions
          )
        )
      );
    }

    match /staffDirectory/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /access/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if hasMenuPermission();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if hasMenuPermission();
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tables/{tableId} {
      allow read: if true;
      allow create, update: if isAdmin() || isWaiter();
      allow delete: if isAdmin();
      allow update: if isAnonymous()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in ["OCCUPIED", "BILL_REQUESTED"];
    }

    match /orders/{orderId} {
      allow read: if isStaff()
        || (isAnonymous() && resource.data.customerUid == request.auth.uid);
      allow create: if isAdmin() || isWaiter()
        || (isAnonymous()
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.status == "PENDING_APPROVAL"
          && request.resource.data.tableId is string
          && request.resource.data.tableId.size() <= 80
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.items.size() <= 50);
      allow update: if isAdmin() || isWaiter() || isKitchen()
        || (isAnonymous()
          && resource.data.customerUid == request.auth.uid
          && request.resource.data.customerUid == request.auth.uid
          && resource.data.status == "PENDING_APPROVAL"
          && request.resource.data.status == resource.data.status
          && request.resource.data.tableId == resource.data.tableId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["items", "updatedAt", "customerCount", "notes", "customerPhone"])
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 50);
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isStaff();
      allow write: if isAdmin() || isWaiter();
      allow create: if isAnonymous()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.type in ["CALL_WAITER", "REQUEST_BILL", "NEW_ORDER"]
        && request.resource.data.tableNumber is int
        && request.resource.data.tableNumber > 0
        && request.resource.data.tableNumber <= 200
        && request.resource.data.resolved == false
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500;
    }

    match /customers/{customerId} {
      allow read, create, update: if isAdmin() || isWaiter();
      allow delete: if isAdmin();
    }

    match /loyaltyTxs/{transactionId} {
      allow read, create, update: if isAdmin() || isWaiter();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read, create, update: if isAdmin() || isWaiter();
      allow delete: if isAdmin();
    }

    match /reservations/{reservationId} {
      allow read, create, update: if isAdmin() || isWaiter();
      allow delete: if isAdmin();
    }

    match /shifts/{shiftId} {
      allow read, create, update: if isAdmin() || isWaiter();
      allow delete: if isAdmin();
    }

    match /ingredients/{ingredientId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isWaiter();
      allow delete: if isAdmin();
    }

    match /inventoryTransactions/{transactionId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isWaiter();
      allow delete: if isAdmin();
    }

    match /promotions/{promotionId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.id == logId
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 120
        && (!("details" in request.resource.data)
          || (request.resource.data.details is string
            && request.resource.data.details.size() <= 2000));
      allow update, delete: if false;
    }

    match /recoveryArchive/{recordId} {
      allow read: if isAdmin();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly([
          "id",
          "collection",
          "documentId",
          "operation",
          "snapshot",
          "createdAt",
          "actorUid"
        ])
        && request.resource.data.id == recordId
        && request.resource.data.collection in [
          "users",
          "tables",
          "categories",
          "products",
          "ingredients",
          "orders",
          "customers",
          "loyaltyTxs",
          "promotions",
          "payments",
          "reservations",
          "shifts",
          "notifications"
        ]
        && request.resource.data.documentId is string
        && request.resource.data.documentId.size() > 0
        && request.resource.data.documentId.size() <= 160
        && request.resource.data.operation in ["UPDATE", "DELETE"]
        && request.resource.data.snapshot is map
        && request.resource.data.snapshot.id == request.resource.data.documentId
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /system/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /settings/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
