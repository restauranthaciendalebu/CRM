rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != "anonymous"
        && firestore.get(/databases/(default)/documents/access/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/access/$(request.auth.uid)).data.role == "ADMIN";
    }

    // Product photos are public to read (shown on the customer-facing menu),
    // but only an authenticated ADMIN can upload/replace/delete one.
    match /product-images/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
